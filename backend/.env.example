# ============================================================
# Django 核心配置
# ============================================================
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,dataprocessing.chengduxiaotiantian.cn

# ============================================================
# 数据库配置
# ============================================================
DB_ENGINE=django.db.backends.mysql
DB_NAME=data_processing
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# ============================================================
# Redis 配置
# ============================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ============================================================
# CORS 配置
# ============================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://dataprocessing.chengduxiaotiantian.cn

# ============================================================
# S3 对象存储配置 (缤纷云 Bitiful S3 兼容)
# ============================================================
# 是否启用 S3 存储 (true=S3, false=本地存储)
USE_S3=false
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET_NAME=your-bucket-name
S3_ENDPOINT_URL=https://s3.bitiful.net
S3_REGION_NAME=cn-east-1
# 自定义域名 (可选, 用于生成文件访问 URL)
S3_CUSTOM_DOMAIN=
