# ============================================================
# Docker Compose 环境变量模板
# 复制为 .env 并填入实际值：cp .env.example .env
# 此文件供 docker-compose.yml 读取（${VAR} 替换）
# 本地非 Docker 开发请参考 README.md 的"环境变量"小节
# ============================================================

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- 数据库 (PostgreSQL) ----
DB_NAME=data_processing
DB_USER=postgres
DB_PASSWORD=change-me-to-a-strong-password

# ---- Redis ----
REDIS_PASSWORD=

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
